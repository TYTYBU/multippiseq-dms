#!/bin/bash -l

#$ -N mPPIseq_dict_09_scatter
#$ -j y
#$ -V
#$ -q all.q@compute-0-0,all.q@compute-0-1
#$ -pe serial 32
#$ -m ae
#$ -M tyu7@bwh.harvard.edu
#$ -wd /net/bgm/sherwood/PPIseq_proj
#$ -o /net/bgm/sherwood/PPIseq_proj/job_out

# Step 09 — per-barcode support x fidelity scatter (one dot per barcode) for
# visual dictionary assessment. This is an EXPLORATORY diagnostic used to CHOOSE
# the per-block thresholds: it is intentionally produced independently of the
# decided parameters (the drawn reference lines are a generic guide, default
# 3 x 0.9, NOT the per-block cutoffs in dictionary_parameters.csv). Uses
# IGNORE_BC from config (bc1-only) so the cloud matches the real dictionary.

source /net/bgm/sherwood/PPIseq_proj/multiPPIseq_DMS_central/qsub/dict_build/config.sh
source "$CONDA_BASE/bin/activate" "$ENV_MAIN"

OUT_DIR="$STATS_PATH/support_accuracy_scatter"
mkdir -p "$OUT_DIR"

python "$SCRIPT_PATH/multiPPIseq_DMS_dict_support_accuracy_scatter.py" \
	--variant_mapped_dir "$VARIANT_MAPPED_PATH/blocks" \
	--out_prefix "$OUT_DIR/support_accuracy" \
	$IGNORE_BC \
	--jobs "$NUM_THREADS"

echo "support x accuracy scatter done -> $OUT_DIR"

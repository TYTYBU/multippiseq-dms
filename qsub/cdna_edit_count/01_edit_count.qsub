#!/bin/bash -l

#$ -N mPPIseq_cDNA_01_editcount
#$ -j y
#$ -V
#$ -q all.q@compute-0-0,all.q@compute-0-1
#$ -pe serial 16
#$ -m ae
#$ -M tyu7@bwh.harvard.edu
#$ -wd /net/bgm/sherwood/PPIseq_proj
#$ -o /net/bgm/sherwood/PPIseq_proj/job_out

# Step 01 — count edits in cDNA samples against the pilot CONCATENATED dictionary.
#   (a) Step1: infer all edited-barcode variants from the concatenated dictionary
#       (built by dict_build step 12 at barcode_to_variant/<LIBTYPE>/concatenated/)
#   (b) Step2: for each batch x rep, anchor the template, call edits, match the
#       barcode (a bc1 reused across blocks counts toward every variant), and
#       write <rep>.cDNA_parsed.csv to a SEPARATE pilot output folder per batch.
# Each Step2 prints one Report_line to stdout, captured per-rep under
# <batch>/<OUT_SUBDIR>/<REPORT_SUBDIR> for the stats step (02). bc1-only
# (--ignore_bc2), matching the dictionary.

source /net/bgm/sherwood/PPIseq_proj/multiPPIseq_DMS_central/qsub/cdna_edit_count/config.sh
source "$CONDA_BASE/bin/activate" "$ENV_MAIN"

if [ ! -f "$DICT_FILE" ]; then
	echo "ERROR: concatenated dict not found: $DICT_FILE" >&2
	echo "       run dict_build step 12 (12_concatenate_dictionary.qsub) first." >&2
	exit 1
fi
mkdir -p "$TEMP_DIR"

# --- (a) Step1: infer all possible edited barcodes from the dictionary -
python "$SCRIPT_PATH/cDNA_parse_step1.py" \
	--dict_in "$DICT_FILE" \
	--edit_mode "$EDIT_MODE" \
	--out_prefix "$TEMP_DIR/$SAMPLE" \
	$IGNORE_BC

# --- (b) Step2: count edits per cDNA rep, per batch -------------------
for batch in $EDITRATE_BATCHES; do
	RAW="$PROJ_PATH/data/$batch/raw_data"
	OUT="$PROJ_PATH/data/$batch/$OUT_SUBDIR"
	REPORTS="$OUT/$REPORT_SUBDIR"
	mkdir -p "$OUT" "$REPORTS"
	shopt -s nullglob
	for f in "$RAW"/*"$SAMPLE_GLOB"*_R1.fastq.gz; do
		f2=$(basename "$f" _R1.fastq.gz)
		echo "Parsing $batch / $f2"
		python "$SCRIPT_PATH/cDNA_parse_step2_allPos.py" \
			--cDNA_in "$f" \
			--dict_in "$DICT_FILE" \
			--bc_alt_prefix "$TEMP_DIR/$SAMPLE" \
			--out "$OUT/${f2}.cDNA_parsed.csv" \
			--edit_mode "$EDIT_MODE" \
			--template_seq "$TEMPLATE_SEQ" \
			--regex_match_len "$REGEX_MATCH_LEN" \
			--r1_post_bc2 "$R1_POST_BC2" \
			--bc1_min_len "$BC1_MIN_LEN" \
			--bc1_max_len "$BC1_MAX_LEN" \
			$IGNORE_BC \
			> "$REPORTS/${f2}.report.txt" &
	done
	shopt -u nullglob
done
wait

echo "cDNA edit count done. parsed + reports -> data/<batch>/$OUT_SUBDIR"

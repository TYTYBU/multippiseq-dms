#!/bin/bash -l

#$ -N mPPIseq_cDNA_01_editcount
#$ -j y
#$ -V
#$ -q all.q@compute-0-0,all.q@compute-0-1
#$ -pe serial 16
#$ -m ae
#$ -M tyu7@bwh.harvard.edu
#$ -wd /net/bgm/sherwood/PPIseq_proj
#$ -o /net/bgm/sherwood/PPIseq_proj/job_out

# Step 01 — count edits in cDNA samples against the pilot CONCATENATED dictionary.
#   (a) Step1: infer all edited-barcode variants from the concatenated dictionary
#       (built by dict_build step 12 at barcode_to_variant/<LIBTYPE>/concatenated/)
#   (b) Step2: for each batch x rep, anchor the template, call edits, match the
#       barcode (a bc1 reused across blocks counts toward every variant), and
#       write <rep>.cDNA_parsed.csv to a SEPARATE pilot output folder per batch.
# Each Step2 prints one Report_line to stdout, captured per-rep under
# <batch>/<OUT_SUBDIR>/<REPORT_SUBDIR> for the stats step (02). bc1-only
# (--ignore_bc2), matching the dictionary.

source /net/bgm/sherwood/PPIseq_proj/multiPPIseq_DMS_central/qsub/cdna_edit_count/config.sh
source "$CONDA_BASE/bin/activate" "$ENV_MAIN"

if [ ! -f "$DICT_FILE" ]; then
	echo "ERROR: concatenated dict not found: $DICT_FILE" >&2
	echo "       run dict_build step 12 (12_concatenate_dictionary.qsub) first." >&2
	exit 1
fi
mkdir -p "$TEMP_DIR"

# --- (a) Step1: infer all possible edited barcodes from the dictionary -
if ! python "$SCRIPT_PATH/cDNA_parse_step1.py" \
	--dict_in "$DICT_FILE" \
	--edit_mode "$EDIT_MODE" \
	--out_prefix "$TEMP_DIR/$SAMPLE" \
	$IGNORE_BC
then
	echo "ERROR: Step1 (barcode expansion) failed; not parsing any reps." >&2
	exit 1
fi

# --- (b) Step2: count edits per cDNA rep, per batch -------------------
# Reps run concurrently, so each PID is recorded and waited on individually
# below: a bare `wait` returns 0 even when a child died, which once let a
# rep with a corrupt input fastq fail silently for months (see decisions log,
# 2026-07-22). Note `wait -n` is unavailable on this host's bash.
PIDS=()
LABELS=()
for batch in $EDITRATE_BATCHES; do
	RAW="$PROJ_PATH/data/$batch/raw_data"
	OUT="$PROJ_PATH/data/$batch/$OUT_SUBDIR"
	REPORTS="$OUT/$REPORT_SUBDIR"
	mkdir -p "$OUT" "$REPORTS"
	shopt -s nullglob
	for f in "$RAW"/*"$SAMPLE_GLOB"*_R1.fastq.gz; do
		f2=$(basename "$f" _R1.fastq.gz)
		# R2 contamination screen (opt-in via R2_FILTER=1). Only 071526 is known to be
		# contaminated with dictionary reads; clean batches are left bit-identical.
		r2_args=()
		if [ "${R2_FILTER:-0}" = "1" ]; then
			r2="${f%_R1.fastq.gz}_R2.fastq.gz"
			if [ ! -f "$r2" ]; then
				echo "ERROR: R2_FILTER=1 but no R2 for $f2 (expected $r2)" >&2
				exit 1
			fi
			r2_args=(--cDNA_in_r2 "$r2" --r2_fixed_seq_lib "$R2_FIXED_SEQ_LIB")
		fi
		# Primary edit position: pin it from config if set, else let the script
		# auto-detect (argmax over variants) per sample.
		primary_args=()
		if [ -n "${PRIMARY_POS:-}" ]; then
			primary_args=(--primary_pos "$PRIMARY_POS")
		fi
		echo "Parsing $batch / $f2"
		python "$SCRIPT_PATH/cDNA_parse_step2_allPos.py" \
			--cDNA_in "$f" \
			"${r2_args[@]}" \
			"${primary_args[@]}" \
			--dict_in "$DICT_FILE" \
			--bc_alt_prefix "$TEMP_DIR/$SAMPLE" \
			--out "$OUT/${f2}.cDNA_parsed.csv" \
			--edit_mode "$EDIT_MODE" \
			--template_seq "$TEMPLATE_SEQ" \
			--regex_match_len "$REGEX_MATCH_LEN" \
			--r1_post_bc2 "$R1_POST_BC2" \
			--bc1_min_len "$BC1_MIN_LEN" \
			--bc1_max_len "$BC1_MAX_LEN" \
			$IGNORE_BC \
			> "$REPORTS/${f2}.report.txt" &
		PIDS+=($!)
		LABELS+=("$batch / $f2")
	done
	shopt -u nullglob
done

if [ "${#PIDS[@]}" -eq 0 ]; then
	echo "ERROR: no R1 fastqs matched *${SAMPLE_GLOB}*_R1.fastq.gz in any batch." >&2
	exit 1
fi

failed=0
for i in "${!PIDS[@]}"; do
	if wait "${PIDS[$i]}"; then
		:
	else
		status=$?
		echo "ERROR: rep failed (exit $status): ${LABELS[$i]}" >&2
		failed=$((failed + 1))
	fi
done

if [ "$failed" -gt 0 ]; then
	echo "ERROR: $failed of ${#PIDS[@]} rep(s) failed; stats (step 02) would silently" >&2
	echo "       summarize only the survivors. Check the input fastqs (gzip -t) first." >&2
	exit 1
fi

# --- (c) Per-sample edit-position bar plots ---------------------------
# One QC plot per parsed CSV: total edit events per editable template position,
# with the primary position highlighted. Runs only after every rep succeeded
# (above), so a plot folder never reflects a partially-failed batch. Plots land in
# a plot/ subfolder beside the CSVs.
for batch in $EDITRATE_BATCHES; do
	OUT="$PROJ_PATH/data/$batch/$OUT_SUBDIR"
	PLOTS="$OUT/plot"
	mkdir -p "$PLOTS"
	shopt -s nullglob
	for csv in "$OUT"/*.cDNA_parsed.csv; do
		rep=$(basename "$csv" .cDNA_parsed.csv)
		python "$SCRIPT_PATH/plot_edit_positions.py" \
			--in_csv "$csv" \
			--out_png "$PLOTS/${rep}.edit_positions.png" \
			|| echo "WARNING: plot failed for $batch / $rep" >&2
	done
	shopt -u nullglob
done

echo "cDNA edit count done: ${#PIDS[@]} rep(s). parsed + reports + plots -> data/<batch>/$OUT_SUBDIR"
